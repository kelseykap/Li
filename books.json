    {
      "id": "09afc0b228f9",
      "title": "I Who Have Never Known Men (FR)",
      "author": "Jacqueline Harpman",
      "publicationDate": "1995-01-01",
      "pageCount": 190,
      "location": null,
      "lat": null,
      "lng": null,
      "status": "read",
      "notes": "The story is so chilling, endless analogies can be made but for me inner story that is most resonant is the question of what it really means to be human when everything else is stripped away, what can we learn, what do we not need to be taught and what cant we when we have no reference to society as it is today, and how much perspective plays a role in how we choose what to value and what has value. If you've never lived in today's world, you can value the other one more than those who have experienced it. And a final flawed (but this time strong) female main character to end off 2025.",
      "rating": 4,
      "dateRead": "2025-12-31",
      "genre": null,
      "medium": "book",
      "coverUrl": null,
      "quotes": [],
      "bookmarked": false,
      "createdAt": "2026-05-28T14:29:36.981450Z",
      "updatedAt": "2026-05-28T14:29:36.981451Z"
